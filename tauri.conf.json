{
  "$schema": "https://raw.githubusercontent.com/nicxlasj/tauri-settings-schema/refs/heads/main/schema.json",
  "productName": "MDD UI",
  "version": "0.1.0",
  "identifier": "io.github.alexmohr.mdd-ui",
  "build": {
    "frontendDist": "frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun install && bun run dev",
    "beforeBuildCommand": "bun install && bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "theme": "Dark",
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "fileAssociations": [
      {
        "ext": ["mdd"],
        "name": "MDD Database",
        "description": "Diagnostic database file",
        "mimeType": "application/x-mdd",
        "role": "Viewer"
      }
    ]
  }
}
